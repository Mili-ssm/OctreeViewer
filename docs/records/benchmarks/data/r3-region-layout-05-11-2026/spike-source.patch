+#[test]
+fn adaptive_leaf_separates_distinct_positions_after_old_limit_with_duplicates() {
+    let blocks = [
+        plain_block(vec![Point::new([0.0; 3], ColorRgb::new(1, 2, 3))]),
+        attributed_block(
+            vec![
+                Point::new([-0.0, 0.0, 0.0], ColorRgb::new(4, 5, 6)),
